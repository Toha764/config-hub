// Gram keymap
//
// For information on binding keys, see the Gram
// documentation: gram://docs/key-bindings
//
// To see the default key bindings run `gram: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {}
  },

  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore"
    }
  },

  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // Save
      "space w": "workspace::Save",

      // Explorer / Agent
      "space e": "project_panel::ToggleFocus",

      // Finders
      "space f f": "file_finder::Toggle",
      "space f g": "workspace::NewSearch",
      "space f b": "tab_switcher::Toggle",
      "space f x": "diagnostics::Deploy",
      "space f s": "outline::Toggle",
      "space f w": "project_symbols::Toggle",

      // Buffers
      "space b d": "pane::CloseActiveItem",

      // Diagnostics
      "space t d": "editor::ToggleDiagnostics",

      // Terminal
      "space t t": "terminal_panel::ToggleFocus",

      // Move lines
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp"
    }
  },

  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",

      // vim-surround
      "shift-s": "vim::PushAddSurrounds"
    }
  },

  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },

  {
    "context": "Dock",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },

  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "space f f": "file_finder::Toggle"
    }
  }
]
