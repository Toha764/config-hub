#  [▁▁▁▁▁▁▁▁···········]  [notch]  [············▁▁▁▁▁▁▁▁]
#  tp_left_filled                   tp_right_empty
#        tp_left_empty    [notch]  tp_right_filled
#
# Order matters: filled must be declared before empty on each side
# so sketchybar stacks them correctly (filled left, dots right of it)
# ───────────────────────────────────────────────────────────────────────────

# ----- config ------

NOTCH_GAP=80 # distance of notch from the left bar
OFFSET=-12  # change this to move the bar vertically (y-axis)
UPDATE_FREQ=10

FONT="JetBrainsMono Nerd Font"
FONT_SIZE=18
# ------------------
PLUGIN="$PLUGIN_DIR/time_progress.sh"

sketchybar \
  \
  --add item tp_left_filled center \
  --set tp_left_filled \
    label.font="$FONT:Regular:$FONT_SIZE" \
    label.color=0xFFF7F7F7 \
    padding_left=0 \
    padding_right=0 \
    label.padding_left=0 \
    label.padding_right=0 \
    y_offset=$OFFSET \
    \
  --add item tp_left_empty center \
  --set tp_left_empty \
    label.font="$FONT:Regular:$FONT_SIZE" \
    label.color=0xFF3A3A3E \
    padding_left=0 \
    padding_right=$NOTCH_GAP \
    label.padding_left=0 \
    label.padding_right=0 \
    y_offset=$OFFSET \
    \
  --add item tp_right_filled center \
  --set tp_right_filled \
    label.font="$FONT:Regular:$FONT_SIZE" \
    label.color=0xFFF7F7F7 \
    padding_left=$NOTCH_GAP \
    padding_right=0 \
    label.padding_left=0 \
    label.padding_right=0 \
    y_offset=$OFFSET \
    \
  --add item tp_right_empty center \
  --set tp_right_empty \
    update_freq=$UPDATE_FREQ \
    label.font="$FONT:Regular:$FONT_SIZE" \
    label.color=0xFF3A3A3E \
    padding_left=0 \
    padding_right=0 \
    label.padding_left=0 \
    label.padding_right=0 \
    y_offset=$OFFSET \
    script="$PLUGIN" \
  --subscribe tp_right_empty system_woke

# ── edge tuning ───────────────────────────────────────────────────────────────
# bottom edge: y_offset=-N where N ~ (bar_height - font_size) / 2 + 1
# top edge:    y_offset=+N
# thinner:     font size 8–9, FILLED_CHAR="▁" is already the thinnest block
# thicker:     font size 14+, FILLED_CHAR="▃" or "▄"
